erDiagram
    direction LR

    USER ||--o{ ATTEMPT : starts
    USER ||--o{ CERTIFICATION : earns
    USER ||--o{ USER_COMPETENCY : develops
    SCENARIO ||--o{ SCENARIO_VERSION : has
    SCENARIO_VERSION ||--o{ ATTEMPT : uses
    ATTEMPT ||--o{ ATTEMPT_EVENT : records
    ATTEMPT ||--o{ ATTEMPT_COMPETENCY : assesses
    ATTEMPT ||--o| CERTIFICATION : results_in
    COMPETENCY ||--o{ ATTEMPT_COMPETENCY : assessed_in
    COMPETENCY ||--o{ USER_COMPETENCY : tracked_for

    USER {
        uuid id PK
        string externalId UK
        string email UK
        string name
        string passwordHash
        string resetTokenHash
        datetime resetTokenExpiresAt
        datetime resetTokenUsedAt
        string depot
        string brigade
        int level
        bigint xp
        string currentServiceClass
        string certificationStatus
    }

    ATTEMPT {
        uuid id PK
        uuid userId FK
        uuid scenarioVersionId FK
        string mode
        string lifecycleStatus
        string resultStatus
        string targetServiceClass
        datetime startedAt
        datetime finishedAt
        string currentNodeId
        jsonb activeModifiersJson
        jsonb selectedVariantsJson
        jsonb contextJson
    }

    ATTEMPT_EVENT {
        bigint id PK
        uuid attemptId FK
        string nodeId
        string choiceId
        string eventType
        datetime occurredAt
        int responseTimeMs
        int safetyDelta
        int loyaltyDelta
        bool criticalError
        string criticalErrorCode
        jsonb eventDataJson
    }

    CERTIFICATION {
        uuid id PK
        uuid userId FK
        uuid attemptId FK, UK
        string serviceClass
        string status
        datetime issuedAt
        datetime expiresAt
    }

    SCENARIO {
        uuid id PK
        string code UK
        string title
        string category
        string difficulty
        bool isActive
        datetime createdAt
        datetime updatedAt
    }

    SCENARIO_VERSION {
        uuid id PK
        uuid scenarioId FK
        int version
        jsonb contentJson
        string sourceDescription
        string createdBy
        bool isPublished
        datetime createdAt
        datetime updatedAt
    }

    COMPETENCY {
        uuid id PK
        string code UK
        string name
        string description
        bool isActive
        datetime createdAt
    }

    USER_COMPETENCY {
        uuid id PK
        uuid userId FK
        uuid competencyId FK
        int score
        string level
        datetime createdAt
        datetime updatedAt
    }

    ATTEMPT_COMPETENCY {
        uuid id PK
        uuid attemptId FK
        uuid competencyId FK
        int score
        string level
        string summary
        datetime createdAt
    }
